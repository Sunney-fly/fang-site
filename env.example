# ==== 数据库 ====
POSTGRES_USER=fang
POSTGRES_PASSWORD=fang123456
POSTGRES_DB=fang_site
# PostgreSQL 16；Prisma schema 用的是 postgresql provider
DATABASE_URL="postgresql://fang:fang123456@127.0.0.1:5432/fang_site"

# ==== 站点 ====
# 用于生成子管理员专属推广链接 / 二维码，必须填最终对外访问的域名
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="安居二手房"

# ==== 会话签名密钥（生产必须改！生成命令: openssl rand -base64 48） ====
SESSION_SECRET="dev-only-secret-please-change-me-in-production-0123456789"

# ==== 客户归属规则 ====
# 归属 Cookie 有效期（天）。客户首次通过某子管理员链接进入后，这段时间内的留资都算该子管理员的
REF_COOKIE_DAYS="90"
